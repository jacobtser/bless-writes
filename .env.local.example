# ============================================================================
#  BLESS BOOKS environment variables
#  Copy this file to `.env.local` and fill in your real values.
# ============================================================================

# ---------------- Supabase (Dashboard > Project Settings > API) --------------
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT-REF>.supabase.co
# Anon / public key. Safe to ship to the browser — it is gated by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Service role key. SECRET — server-only. NEVER put this in client-side code,
# NEVER prefix it with NEXT_PUBLIC_, and NEVER commit it.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --------------- Offline reading (offline encryption key) --------------------
# SECRET — server-only. A long, random, stable value. The offline reader derives
# each user's AES/HMAC keys from an HMAC of their user id under this secret, so
# it must persist across deploys or previously saved books stop decrypting.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
OFFLINE_KEY_SECRET=replace-with-a-long-random-secret

# ------------------------------ Stripe --------------------------------------
# Dashboard > Developers > API keys
STRIPE_SECRET_KEY=sk_test_...
# Local: from `stripe listen --forward-to localhost:3000/api/webhook`
# Production: from Stripe Dashboard > Developers > Webhooks (endpoint secret)
STRIPE_WEBHOOK_SECRET=whsec_...

# --------------------------- Flutterwave (MoMo) -----------------------------
# Dashboard > Settings > API keys (the key that starts with FLWSECK_TEST_ in
# test mode). SECRET — server-only, never to the browser, never committed.
FLW_SECRET_KEY=FLWSECK_TEST_...
# Dashboard > Settings > Webhooks > "Secret hash (verif-hash)". Any string.
# Used to authenticate Flutterwave webhook calls.
FLW_WEBHOOK_HASH=bless-books-secret-hash